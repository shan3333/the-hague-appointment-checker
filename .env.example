# Target (used only by real checks and optional browser opening)
APPOINTMENT_MODE=real
APPOINTMENT_URL=https://denhaag.mijnafspraakmaken.nl/?product=35

# Real monitoring schedule (APPOINTMENT_MODE=real)
CHECK_INTERVAL_MINUTES=5
MONITOR_TIMEZONE=Europe/Amsterdam
MONITOR_DAYS=1,2,3,4,5
MONITOR_START_HOUR=8
MONITOR_END_HOUR=22

# Browser and reliability
HEADLESS=true
NAVIGATION_TIMEOUT_MS=30000
SELECTOR_TIMEOUT_MS=30000
MAX_RETRIES=2
RETRY_BACKOFF_MS=5000

# Notifications and availability actions
ENABLE_DESKTOP_NOTIFICATION=true
ENABLE_SOUND=true
NOTIFICATION_PROVIDER=auto
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ENABLE_OPEN_BROWSER=true
ENABLE_SCREENSHOT=true
SAVE_LOAD_ERROR_SCREENSHOT=true

# Debugging (DEBUG_KEEP_BROWSER_OPEN_MS applies only to one-off slow checks)
DEBUG_SLOW_MODE=false
DEBUG_STEP_DELAY_MS=2000
DEBUG_KEEP_BROWSER_OPEN_MS=15000
DEBUG_SCREENSHOTS=false

# Fixed simulation (APPOINTMENT_MODE=simulate-fixed)
# Required value: AVAILABLE or NOT_AVAILABLE
SIMULATE_STATUS=AVAILABLE
# Comma-separated ISO dates used by fixed simulation and as the timeline fallback.
SIMULATE_APPOINTMENT_DATES=2026-08-10,2026-08-20

# Timeline simulation (APPOINTMENT_MODE=simulate-timeline)
SIMULATION_SEQUENCE=NOT_AVAILABLE,NOT_AVAILABLE,AVAILABLE,AVAILABLE,AVAILABLE,AVAILABLE
SIMULATION_REPEAT=true
SIMULATION_INTERVAL_SECONDS=10
SIMULATION_KEEP_BROWSER_OPEN_MS=5000
SIMULATION_PAUSE_BEFORE_CLOSE=false
# Optional per-cycle dates: semicolon separates cycles, comma separates dates,
# and a hyphen represents a cycle with no dates.
SIMULATION_DATE_SEQUENCE=-;-;2026-08-10;2026-08-10,2026-08-25;2026-09-10;-
